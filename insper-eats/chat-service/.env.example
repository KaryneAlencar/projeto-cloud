# Arquivo exclusivo do Chat Service. Copie para .env e preencha localmente.
# Pode usar o PostgreSQL local existente: somente tabelas chat_* serão criadas.
CHAT_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@127.0.0.1:5433/NOME_DO_BANCO
ORDERS_API_URL=http://127.0.0.1:8000
ORDERS_API_TIMEOUT=5

# gemini: IA real. commands: roteiro explícito para desenvolvimento sem IA.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternativa opcional: AI_PROVIDER=openai com OPENAI_API_KEY e OPENAI_MODEL.
# Prazo total do ciclo de IA, em segundos.
AI_TIMEOUT=120

# Sessão anônima do navegador. Em HTTPS na AWS: COOKIE_SECURE=true.
COOKIE_SECURE=false
SESSION_DAYS=30
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
