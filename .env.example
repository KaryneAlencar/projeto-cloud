# Copie para .env (ignorado pelo Git) e preencha. Usado pelo compose.yaml,
# por scripts/start-local.sh (ou .ps1) e pelo backend quando roda fora do Docker.

# Banco PostgreSQL local (compose.yaml, porta 5433 no host).
POSTGRES_USER=insper
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=insper_eats

# URL que API e chat usam DENTRO do Docker (host "db", porta 5432). O script
# scripts/start-local.ps1 gera este valor sozinho em .env.docker; o start-local.sh
# usa a linha abaixo: mantenha-a coerente com usuário, senha e banco acima.
APP_DATABASE_URL=postgresql+psycopg://insper:troque-esta-senha@db:5432/insper_eats

# Só para rodar a API/worker fora do Docker (uvicorn main:app em backend/).
DATABASE_URL=postgresql+psycopg://insper:troque-esta-senha@127.0.0.1:5433/insper_eats

# Token exigido pela API em /pedidos (cabeçalho X-Internal-Token). O chat precisa
# do mesmo valor (chat-service/.env). Sem definir, o compose local usa um padrão
# de desenvolvimento; fora do Docker, /pedidos responde 503 enquanto estiver vazio.
ORDERS_INTERNAL_TOKEN=
